{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "postUpdateOptions": ["gomodTidy"],
  "packageRules": [
    {
      "description": "k8s.io modules must move together (kubectl, client-go, api, apimachinery, cli-runtime, component-base)",
      "matchManagers": ["gomod"],
      "matchPackageNames": ["k8s.io/**", "sigs.k8s.io/**"],
      "groupName": "kubernetes"
    },
    {
      "matchManagers": ["gomod"],
      "matchPackageNames": ["github.com/linode/linodego"],
      "groupName": "linodego"
    },
    {
      "description": "patch updates merge themselves once CI (unit + e2e) passes",
      "matchUpdateTypes": ["patch", "digest"],
      "automerge": true
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "github actions"
    }
  ]
}
